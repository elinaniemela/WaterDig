    "                                     \"ne_110m_admin_0_countries\",\n",
    "                                     \"ne_110m_admin_0_countries.shp\")\n",
    "\n",
    "#read in a new geopandas data frame called \"cities\"\n",
    "world = gpd.read_file(world_path)\n",
    "print(world)"
   ]
